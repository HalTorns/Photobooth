{
  "name": "photobooth",
  "version": "0.3.0",
  "private": true,
  "description": "Photobooth tactile hors ligne pour Windows",
  "author": "HalTorns",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build && node scripts/notices.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/e2e.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:frames": "node scripts/frames-test.cjs",
    "test:stickers": "node scripts/stickers-test.cjs",
    "dist": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "fr.haltorns.photobooth",
    "productName": "Photobooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
